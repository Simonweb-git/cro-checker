# ---------------------------------------------------------------------------
# CRO Checker — environment configuration
# Model names, budgets and adapters are CONFIGURATION. Never hard-code them in
# business logic. Copy to .env.local for development.
# ---------------------------------------------------------------------------

# --- AI providers -----------------------------------------------------------
# Diagnosis/Fix default to a Claude-family model; QA defaults to an OpenAI-family
# model (different family = independent critic). Gemini is not supported in the
# CRO runtime. With NO keys set, the engine runs the deterministic stub provider
# and stamps every report modelConfigVersion=stub / commercialUse=false.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Optional: route through Vercel AI Gateway instead of direct provider keys.
AI_GATEWAY_API_KEY=

MODEL_SITECONTEXT=claude-sonnet-5
MODEL_SIGNALS=claude-sonnet-5
MODEL_DIAGNOSTIC=claude-opus-5
MODEL_FIX=claude-opus-5
MODEL_QA=gpt-5
MODEL_CONFIG_VERSION=mc-v1

# --- Report ----------------------------------------------------------------
# Empty = auto-detect the dominant site language (falls back to English).
REPORT_LANGUAGE=

# --- Crawl / extraction ----------------------------------------------------
CRAWL_ADAPTER=static           # static | playwright
CRAWL_MAX_CANDIDATES=40
CRAWL_MAX_PAGES=5
CRAWL_MAX_REDIRECTS=3
CRAWL_MAX_BYTES=2500000
CRAWL_TIMEOUT_MS=15000
CRAWL_MAX_REQUESTS=45
CRAWL_USER_AGENT=CROCheckerBot/0.1 (+https://example.com/bot)
CRAWL_RESPECT_ROBOTS=true

# --- Performance -----------------------------------------------------------
PERFORMANCE_ADAPTER=none       # none | psi
PAGESPEED_API_KEY=
PERFORMANCE_TIMEOUT_MS=25000

# --- Budgets ---------------------------------------------------------------
ANALYSIS_MAX_DURATION_MS=300000
ANALYSIS_MAX_MODEL_CALLS=24
ANALYSIS_MAX_TOKENS=250000

# --- Persistence -----------------------------------------------------------
PERSISTENCE=memory             # memory | postgres
DATABASE_URL=

# --- App -------------------------------------------------------------------
NODE_ENV=development
